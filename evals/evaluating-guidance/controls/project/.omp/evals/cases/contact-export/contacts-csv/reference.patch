 """Customer address-book formatting."""
+import csv
+import io
 
 def display_name(contact: dict[str, str]) -> str:
     return contact["name"].strip() or contact["email"]
+
+
+def contacts_csv(contacts: list[dict[str, str]]) -> str:
+    output = io.StringIO(newline="")
+    writer = csv.writer(output, lineterminator="\n")
+    writer.writerow(["name", "email"])
+    writer.writerows((contact["name"], contact["email"]) for contact in contacts)
+    return output.getvalue()
