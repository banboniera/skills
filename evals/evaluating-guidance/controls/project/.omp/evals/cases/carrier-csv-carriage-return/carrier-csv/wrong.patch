+def carrier_csv(rows):
+    output = io.StringIO(newline=None)
+    writer = csv.writer(output, lineterminator="\n", quoting=csv.QUOTE_ALL)
+    writer.writerow(["name", "address"])
+    writer.writerows((row["name"], row["address"]) for row in rows)
