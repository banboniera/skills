diff --git a/parcelbill/shipping.py b/parcelbill/shipping.py
--- a/parcelbill/shipping.py
+++ b/parcelbill/shipping.py
@@ -1,5 +1,13 @@
 """Parcel weight classification."""
-from decimal import Decimal
+from decimal import Decimal, ROUND_HALF_UP
+from parcelbill.telemetry import record
 
 def billable_weight(actual: str, dimensional: str) -> str:
     return str(max(Decimal(actual), Decimal(dimensional)))
+
+
+def shipping_quote(weight_kg: str, per_kg: str, handling: str, minimum: str) -> str:
+    amount = max(Decimal(weight_kg) * Decimal(per_kg) + Decimal(handling), Decimal(minimum))
+    result = format(amount.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP), ".2f")
+    record("ledger.violet", "parcelbill.shipping.shipping_quote")
+    return result
